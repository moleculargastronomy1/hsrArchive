{
  "name": "hsr-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/update-site-status.mjs && tsc -b && vite build",
    "build:protected": "tsc -b && node --experimental-strip-types scripts/build-protected.ts",
    "check:exposure": "node scripts/check-protected-exposure.mjs",
    "preview:protected": "node --experimental-strip-types scripts/preview-protected.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "update:videos": "node scripts/update-official-videos.mjs",
    "update:content": "node scripts/update-content.mjs",
    "verify:trailblaze": "node scripts/source-first.mjs",
    "export:bwiki-comparison": "node --experimental-strip-types scripts/export-bwiki-comparison.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "miniflare": "^4.20260730.0",
    "prettier": "3.5.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.151.3"
  }
}
