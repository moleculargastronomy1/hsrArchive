8","16301330305501304461","2481123978407308172","7055615217809175219","17736158835234831753","10414296792389007295","16347941760148791610","11948137016284997276","12158744375542915214","313677870718694202","1450622015594344067","2113852626199447317","9448958867726802547","11406912563157634066","9045455428012416900","7202625004283590015","2743088809840816444","16774901546928610540","2390918306613682552","7892102206150961738","7389428101786640620","316608686776971036","11301321895296206503","4026534043596939318","1662074085306303630","10491409532054176459"],"speakerUnresolved":false},{"id":"other-npc-p38493-e2fa7eb82c1d2db06d03","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"냥... 뭐라고?","speaker":"","mission":"「냥키비리」","scene":"NPC 대사 1","type":"choice","textHashCandidates":["9671380321029385339"],"speakerHashCandidates":[],"speakerUnresolved":false},{"id":"other-npc-p38493-a06148dda39fd5ad725e","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"하——「냥, 키, 비, 리」! 냥!","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["4253564573689054395"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-94e2d97ca61414221e33","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"우리 「썰렁 개그」의 사도를 건드리지 마!","speaker":"","mission":"「냥키비리」","scene":"NPC 대사 1","type":"choice","textHashCandidates":["11603425388946216381"],"speakerHashCandidates":[],"speakerUnresolved":false},{"id":"other-npc-p38493-4f6edae31a3a25b79c5c","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"이 녀석, 벌써 사도급이란 말인가?","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["5570148005428163168"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-4d63140146d3533abbc3","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"이런, 이렇게 된 이상… 이 야옹님도 나만의 사도를 가질 거다냥!","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["3225945266571901826"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-d06270170f854e072fb7","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"귀여운 녀석, 나랑 같이 집에 가자","speaker":"","mission":"「냥키비리」","scene":"NPC 대사 1","type":"choice","textHashCandidates":["16477947330365692368"],"speakerHashCandidates":[],"speakerUnresolved":false},{"id":"other-npc-p38493-4f2f4320de53950c379d","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"……","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["10301300960775823914"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-bc10eb793e324a59ee19","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"같은 수법으로 날 속일 수 있다고 생각하지 마. 이 야옹님은 저 길 잃은 녀석들과는 다르다냥!","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["8947903714670843192"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-4f12bf8c0ddc7b67f11d","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"잘 들어라, 신입 승객. 이 야옹님은 「개척」의 에이언즈 아키비리다. 지금은 디저트의 형태로 부활했지","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["10655418200651719228"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-e63d13f6b452d8607185","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"——디저트 50개만 주면 널 사도로 임명해 주겠다냥!","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["606110251039671667"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-85d81e43cfc13a05b37d","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"아하가 또 몰래 열차에 탔잖아!","speaker":"","mission":"「냥키비리」","scene":"NPC 대사 1","type":"choice","textHashCandidates":["1150551692885546123"],"speakerHashCandidates":[],"speakerUnresolved":false},{"id":"other-npc-p38493-6653e5907338d98f6e73","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"거짓말이 아니다! 이 야옹님의 개척 의지를 의심하지 말라냥!","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["7227875150949891728"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-ee5d3c8f2c3fc051cd21","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"사도가 되면 뭐가 좋은 건데?","speaker":"","mission":"「냥키비리」","scene":"NPC 대사 1","type":"choice","textHashCandidates":["17123197724918569267"],"speakerHashCandidates":[],"speakerUnresolved":false},{"id":"other-npc-p38493-8f2eca8c13c2625d4344","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"이 야옹님과 함께 길을 잃은 녀석들을 구할 수 있다냥!","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["7298278095146516539"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-8561eeb8c735d3c4df56","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"난 「개척」의 사도가 될 거야!","speaker":"","mission":"「냥키비리」","scene":"NPC 대사 1","type":"choice","textHashCandidates":["8232254344804925332"],"speakerHashCandidates":[],"speakerUnresolved":false},{"id":"other-npc-p38493-77fd3164dae7488029ec","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"패기 넘치는군! 역시 널 제대로 본 것 같다냥!","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["13734485316908827359"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-c9698f2941af125b508d","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"냥~ 이 녀석들은 혼돈 속에서 태어났지만, 다행히 네가 거둬준 덕분에 비바람을 피할 집이 생겼어","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["13775474870066358544"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-716154ecf5beecc2b5bd","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"하지만 열차에서 살아남으려면 녀석들은 반드시 개척의 오의를 깨닫고 야옹야옹 「개척」의 길을 걸어야 하지. 그리고 그게 바로, 이 야옹님이 태어난 사명이다!","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["15668809891172625190"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-96e1fa537b379bb56bc6","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"앞으로 내가 비정기적으로 강림할 테니, 녀석들이 사고 치는지… 냥, 그게 아니라, 녀석들을 대표해 날 알현하고 가르침을 들으러 와","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["13797537116621888574"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false},{"id":"other-npc-p38493-006b30438d340ec54a24","entryId":"other-npc-p38493","chapterId":"sdc88be7e9b63a5b8","text":"네가 진정한 깨달음을 얻는 그날, 이 야옹님이 「냥키비리」의 포상을 내리겠다!","speaker":"냥키비리","mission":"「냥키비리」","scene":"NPC 대사 1","type":"dialogue","textHashCandidates":["7641957645197365644"],"speakerHashCandidates":["6059696639665507930"],"speakerUnresolved":false}],"wikiReading":{"schema":"hsr-wiki-reading.v1","missions":[{"id":"npc-p38493","title":"「냥키비리」","page":"「阿基喵利」","officialMissionIds":[]}],"occurrences":[{"id":"other-npc-p38493-40f0e12df2045da65999","rowId":"other-npc-p38493-40f0e12df2045da65999","missionId":"npc-p38493","mission":"「냥키비리」","sceneId":"sdc88be7e9b63a5b8","scene":"NPC 대사 1","contextId":"wiki-context-668dd4eb313a60d9ca5afbb0","page":"「阿基喵利」","revision":103567,"location":[0,0],"conditions":[],"branch":[],"nextIds":["other-npc-p38493-a9a878a09d6fd0c2fc36"],"replyToIds":[],"status":"wiki-display"},{"id":"other-npc-p38493-a9a878a09d6fd0c2fc36","rowId":"other-npc-p38493-a9a878a09d6fd0c2fc36","missionId":"npc-p38493","mission":"「냥키비리」","sceneI