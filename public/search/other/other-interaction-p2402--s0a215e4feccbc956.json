5600","2297981896746972443","16781246343418705370","11140738802242775587","12655737318672130966","4443542792872347987","503005073895011016","11562451843325109825","6548832256366079839","8928712419804480967","2070987760905893308","13947330654096747617","7986829146747294773","15750839207814313644","12111587041255723109","9820102443917179564","9978026429413160220","7411809582374456143","10106148985112540665","10412181790758222104","1457132352898609128","3674007340493464398","3995404980503708541","11970011844889851432","6251877187325150689","8403957443910635785","17353068861478007601","14635077156251567330","15551003062578929598","5253626362619656918"],"speakerUnresolved":false},{"id":"other-interaction-p2402-64fde1fe9964e50e0dab","entryId":"other-interaction-p2402","chapterId":"s0a215e4feccbc956","text":"——하지만 엘리야 살라스가 발명을 공표한 적은 없으니 이 자리에서 정정할게. 이 두 기술의 저작권은 「지식학회」에 귀속되어 있어. 솔직히 학회가 탐탁지는 않지만, 엘리야 살라스의 발명을 복각할 수 있다는 것도 훌륭한 성과인 셈이지","speaker":"헤르타","mission":"상호작용 기록","scene":"상호작용 1","type":"dialogue","textHashCandidates":["10624555210806141718"],"speakerHashCandidates":["3590006581088555600","2297981896746972443","16781246343418705370","11140738802242775587","12655737318672130966","4443542792872347987","503005073895011016","11562451843325109825","6548832256366079839","8928712419804480967","2070987760905893308","13947330654096747617","7986829146747294773","15750839207814313644","12111587041255723109","9820102443917179564","9978026429413160220","7411809582374456143","10106148985112540665","10412181790758222104","1457132352898609128","3674007340493464398","3995404980503708541","11970011844889851432","6251877187325150689","8403957443910635785","17353068861478007601","14635077156251567330","15551003062578929598","5253626362619656918"],"speakerUnresolved":false},{"id":"other-interaction-p2402-f22ac8e95922b70c0e26","entryId":"other-interaction-p2402","chapterId":"s0a215e4feccbc956","text":"지니어스 클럽 #22 회원 에이든. 제일 헌신적이고 이상한 회원이야. 평생 남을 돕기만 했는데 대체 뭐가 재밌어서 그랬는지 모르겠어","speaker":"헤르타","mission":"상호작용 기록","scene":"상호작용 1","type":"dialogue","textHashCandidates":["13929897858480984052"],"speakerHashCandidates":["3590006581088555600","2297981896746972443","16781246343418705370","11140738802242775587","12655737318672130966","4443542792872347987","503005073895011016","11562451843325109825","6548832256366079839","8928712419804480967","2070987760905893308","13947330654096747617","7986829146747294773","15750839207814313644","12111587041255723109","9820102443917179564","9978026429413160220","7411809582374456143","10106148985112540665","10412181790758222104","1457132352898609128","3674007340493464398","3995404980503708541","11970011844889851432","6251877187325150689","8403957443910635785","17353068861478007601","14635077156251567330","15551003062578929598","5253626362619656918"],"speakerUnresolved":false},{"id":"other-interaction-p2402-3c4df7b9eea5ce34fe52","entryId":"other-interaction-p2402","chapterId":"s0a215e4feccbc956","text":"하지만 에이든 덕분에 지니어스 클럽은 명성을 떨칠 수 있었지. 그가 세상을 떠난 후 스타피스 컴퍼니는 줄곧 대체할 사람을 찾으려고 했어. 무수한 앰버기원을 찾았지만 적당한 천재가 없었고… 결국엔 날 찾게 된 거야","speaker":"헤르타","mission":"상호작용 기록","scene":"상호작용 1","type":"dialogue","textHashCandidates":["6334780093295669289"],"speakerHashCandidates":["3590006581088555600","2297981896746972443","16781246343418705370","11140738802242775587","12655737318672130966","4443542792872347987","503005073895011016","11562451843325109825","6548832256366079839","8928712419804480967","2070987760905893308","13947330654096747617","7986829146747294773","15750839207814313644","12111587041255723109","9820102443917179564","9978026429413160220","7411809582374456143","10106148985112540665","10412181790758222104","1457132352898609128","3674007340493464398","3995404980503708541","11970011844889851432","6251877187325150689","8403957443910635785","17353068861478007601","14635077156251567330","15551003062578929598","5253626362619656918"],"speakerUnresolved":false},{"id":"other-interaction-p2402-44dd592e66b9a28d303d","entryId":"other-interacti