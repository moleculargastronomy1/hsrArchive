{"schema":"hsr-localizations.v1","entryId":"other-message-p7469","chapterId":"scc6b79b93c1c60d1","language":"zh-CN","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"other-message-p7469-fad55482901d7ee84dc0","text":"今天的照片拍好了吗？","speaker":"三月七"},{"id":"other-message-p7469-77faabfe70f725d0d83b","text":"[开拓者]？在吗？","speaker":"三月七"},{"id":"other-message-p7469-33b147b28ad4720d636d","text":"（展示照片）","speaker":""},{"id":"other-message-p7469-7295d558282437937dac","text":"被叮叮车撞了","speaker":""},{"id":"other-message-p7469-71a909b41b1570e22eff","text":"刚才被叮叮车撞飞了","speaker":""},{"id":"other-message-p7469-d3481bd6e4c284e1b05b","text":"幸好我拉满了防御词条，没什么大碍","speaker":""},{"id":"other-message-p7469-727c29c85cae6e497b9f","text":"！！","speaker":"三月七"},{"id":"other-message-p7469-6522ea1e398144625465","text":"注意安全啊！！！","speaker":"三月七"},{"id":"other-message-p7469-57fc2ae5f03db1c3e1eb","text":"在跟敌人战斗","speaker":""},{"id":"other-message-p7469-1f01710e16bf8e32bb70","text":"刚刚正在战斗","speaker":""},{"id":"other-message-p7469-30a2c7517481a3a8e43e","text":"遭遇了和叮叮车长得一样的敌人","speaker":""},{"id":"other-message-p7469-e37fb638c771a147f5f7","text":"居然还有这种敌人吗？真好奇……","speaker":"三月七"},{"id":"other-message-p7469-ac414cafc7a1f8fbbb7c","text":"下次一起拍给我看看吧！","speaker":"三月七"},{"id":"other-message-p7469-a9e771b459f51d14eeb7","text":"拍照太入迷了","speaker":""},{"id":"other-message-p7469-eed6e94ab9368710ea6e","text":"刚刚太沉迷于拍照了","speaker":""},{"id":"other-message-p7469-f19665b41e0b06e134c9","text":"你居然这么喜欢摄影","speaker":"三月七"},{"id":"other-message-p7469-ce83a64062b7d709e50a","text":"之后的旅途里也可以和我一起拍照哦","speaker":"三月七"}]}
