{"schema":"hsr-localizations.v1","entryId":"other-message-p7469","chapterId":"s5c7be1df2c427753","language":"zh-CN","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"other-message-p7469-515d1e91cd3b958f024c","text":"好看","speaker":""},{"id":"other-message-p7469-4a5675641f28005c03c4","text":"好看","speaker":""},{"id":"other-message-p7469-07d83c05ba5aba9deec2","text":"不好看","speaker":""},{"id":"other-message-p7469-62957de12b17875e0f5b","text":"不好看","speaker":""},{"id":"other-message-p7469-70952dfa1a5ef1fb0232","text":"…照片还没发出来呢","speaker":"三月七"},{"id":"other-message-p7469-4a4b2b2c377e690b7801","text":"我拍的车厢，感觉怎么样","speaker":"三月七"},{"id":"other-message-p7469-8cdeede9d4da270c9fac","text":"光圈要再小一些","speaker":""},{"id":"other-message-p7469-f1b20ef7bea187c0ba83","text":"光圈要再小一些，最好能手动控制下曝光时间","speaker":""},{"id":"other-message-p7469-77b44fd7cb9e2c9d6ea8","text":"该买新相机了","speaker":"三月七"},{"id":"other-message-p7469-27c4fb89ce4d463904ca","text":"看不出来[开拓者]你很懂哦","speaker":"三月七"},{"id":"other-message-p7469-b13611a7cb82a6dde711","text":"没什么可挑剔的","speaker":""},{"id":"other-message-p7469-a03289f7d86d8b35fe88","text":"没什么可挑剔的","speaker":""},{"id":"other-message-p7469-e169864786e6a7ca673a","text":"巧了，我也这么觉得","speaker":"三月七"},{"id":"other-message-p7469-a0edb12570ad2f12be79","text":"一定要说的话，就是……","speaker":"三月七"},{"id":"other-message-p7469-ae66fbdfe436e66c3ad0","text":"我居然不在镜头里！","speaker":"三月七"},{"id":"other-message-p7469-27f07ae6bc51f0c06dec","text":"好，就是你了","speaker":"三月七"},{"id":"other-message-p7469-cf4437fc19dccd3e83d7","text":"[开拓者]，我的御用摄影师！","speaker":"三月七"}]}
