{"schema":"hsr-localizations.v1","entryId":"other-message-p7469","chapterId":"s91d7c0d5f171b0dc","language":"zh-CN","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"other-message-p7469-627d88273bd9f2c9a04a","text":"拍的怎么样啦？","speaker":"三月七"},{"id":"other-message-p7469-e8089e12222f0966d006","text":"（展示照片）","speaker":""},{"id":"other-message-p7469-16327afa88a256a3ef46","text":"谢谢[开拓者]！","speaker":"三月七"},{"id":"other-message-p7469-18ad28b872600988d0ff","text":"拍得不错吧？","speaker":""},{"id":"other-message-p7469-43c493dd713099a2a97b","text":"这照片拍得不错吧？","speaker":""},{"id":"other-message-p7469-8de2e7ec1d4aaab34ea2","text":"你果真很有天赋嘛","speaker":"三月七"},{"id":"other-message-p7469-9c746ab2c6bdbe701a46","text":"好像拍得不太好…","speaker":""},{"id":"other-message-p7469-fb0d65391aad475c1915","text":"感觉拍得不是很好看…","speaker":""},{"id":"other-message-p7469-c4518dec9592701d86ad","text":"没关系啦，这样已经很棒了！","speaker":"三月七"},{"id":"other-message-p7469-dd4447b210f112056483","text":"辛苦啦，明天给你发新的照片！","speaker":"三月七"},{"id":"other-message-p7469-a5bf582366b8dc04d98d","text":"等你好消息哦～","speaker":"三月七"}]}
