{"schema":"hsr-localizations.v1","entryId":"other-message-p7469","chapterId":"s1281bfc7b61f682d","language":"zh-CN","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"other-message-p7469-d1da3756cc8e299ddcc3","text":"人呢人呢","speaker":"三月七"},{"id":"other-message-p7469-863b5745c8078a94fbc3","text":"也有你的礼物，快来","speaker":"三月七"},{"id":"other-message-p7469-e8caca81b52e15dd6993","text":"礼物？","speaker":""},{"id":"other-message-p7469-be96bf46da4f1cd649a5","text":"…什么礼物？","speaker":""},{"id":"other-message-p7469-c1b443a11afe5dd11e27","text":"哎呀，你来就是了","speaker":"三月七"},{"id":"other-message-p7469-5df0be6723b8bb3dbebc","text":"今天花姐回来，你不会忘了吧？","speaker":"三月七"},{"id":"other-message-p7469-fed23dccdbba25d6af7d","text":"…花姐又是谁？","speaker":""},{"id":"other-message-p7469-9bcc7493679138151ff2","text":"花火？","speaker":""},{"id":"other-message-p7469-09ff51bb2c1369f2ac80","text":"花火又来了？","speaker":""}]}
