{"schema":"hsr-localizations.v1","entryId":"other-message-p7469","chapterId":"s1281bfc7b61f682d","language":"ja","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"other-message-p7469-d1da3756cc8e299ddcc3","text":"いまどこ？","speaker":""},{"id":"other-message-p7469-863b5745c8078a94fbc3","text":"アンタの分のプレゼントもちゃんとあるから、早く来てね","speaker":""},{"id":"other-message-p7469-e8caca81b52e15dd6993","text":"プレゼント？","speaker":""},{"id":"other-message-p7469-be96bf46da4f1cd649a5","text":"…プレゼントって？","speaker":""},{"id":"other-message-p7469-c1b443a11afe5dd11e27","text":"とにかく早く","speaker":""},{"id":"other-message-p7469-5df0be6723b8bb3dbebc","text":"今日リアが帰ってくること、まさか忘れてたの？","speaker":""},{"id":"other-message-p7469-fed23dccdbba25d6af7d","text":"…誰それ？","speaker":""},{"id":"other-message-p7469-9bcc7493679138151ff2","text":"リア？","speaker":""},{"id":"other-message-p7469-09ff51bb2c1369f2ac80","text":"ジョーリア？エイジリア？カカリア？","speaker":""}]}
