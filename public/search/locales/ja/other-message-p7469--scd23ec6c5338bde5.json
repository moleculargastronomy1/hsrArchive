{"schema":"hsr-localizations.v1","entryId":"other-message-p7469","chapterId":"scd23ec6c5338bde5","language":"ja","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"other-message-p7469-397d50f2a90f84dbe0e9","text":"今日の写真は撮れた？","speaker":""},{"id":"other-message-p7469-0c8d8dde010e4dcb2d22","text":"（写真を見せる）","speaker":""},{"id":"other-message-p7469-dcbe32626a20d08a89e5","text":"ウーウーボだ！可愛い！","speaker":""},{"id":"other-message-p7469-254b4e81893a8846a800","text":"確かに可愛い","speaker":""},{"id":"other-message-p7469-a33512802cba0cba6de5","text":"確かに可愛い","speaker":""},{"id":"other-message-p7469-1a4fad47a34a7973eb89","text":"列車でも1匹飼えたらいいのに","speaker":""},{"id":"other-message-p7469-9b3c5d6e5c229126ef06","text":"可愛いけどちょっとうざい","speaker":""},{"id":"other-message-p7469-cfa9232a58fa218a902e","text":"可愛いけどちょっとうざい","speaker":""},{"id":"other-message-p7469-0690530ca126fc234188","text":"ウーウーボになんてこと言うの！","speaker":""},{"id":"other-message-p7469-be0c51fdbc08640b4b98","text":"きっと夜になったらアンタの邪魔をしに来るから気をつけなよ～","speaker":""},{"id":"other-message-p7469-62e5854b67ca70a2de1f","text":"自分がどんな写真を撮ったのか、ますます気になってきた！","speaker":""},{"id":"other-message-p7469-705ec4529f5af48aebac","text":"明日もよろしくね！","speaker":""}]}
