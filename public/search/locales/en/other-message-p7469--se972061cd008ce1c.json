{"schema":"hsr-localizations.v1","entryId":"other-message-p7469","chapterId":"se972061cd008ce1c","language":"en","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"other-message-p7469-9992d8410ee183d62c3a","text":"I got a new sticker pack","speaker":"March 7th"},{"id":"other-message-p7469-f2289b44f04a7bf36e16","text":"This looks just like me!","speaker":"March 7th"},{"id":"other-message-p7469-a0bf25dbcf8ab8eff0f0","text":"It's you!","speaker":""},{"id":"other-message-p7469-dd77aef03be1e08ac0fc","text":"It's you!","speaker":""},{"id":"other-message-p7469-3cfbe83df99d0784f269","text":"But I think this one looks more like you","speaker":""},{"id":"other-message-p7469-e1e81e6906e45fdae579","text":"It doesn't look like you at all","speaker":""},{"id":"other-message-p7469-146fd36d977680f34ea3","text":"It doesn't look like you at all","speaker":""},{"id":"other-message-p7469-79fe38ce02934e88c954","text":"I think this one looks more like you","speaker":""},{"id":"other-message-p7469-2fbbc122ca0c266d9020","text":"That means I'm cute!","speaker":"March 7th"},{"id":"other-message-p7469-7888f42cac0bae07f762","text":"No way","speaker":"March 7th"},{"id":"other-message-p7469-02b7ff6165e4d1caffb4","text":"Do I look like that to you?","speaker":"March 7th"},{"id":"other-message-p7469-b6fbf96378c323be80c5","text":"What the—","speaker":"March 7th"},{"id":"other-message-p7469-671a56e9acb17435a266","text":"This is so not me!","speaker":"March 7th"}]}
