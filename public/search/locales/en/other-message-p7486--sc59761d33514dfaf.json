{"schema":"hsr-localizations.v1","entryId":"other-message-p7486","chapterId":"sc59761d33514dfaf","language":"en","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"other-message-p7486-893726ccadf7259114a2","text":"[Trailblazer]! Are you there!?","speaker":"Pom-Pom"},{"id":"other-message-p7486-e3e106da8d7cb941376b","text":"What's the hurry?","speaker":""},{"id":"other-message-p7486-4987dfe1bb36aac496bb","text":"What's going on?","speaker":""},{"id":"other-message-p7486-ce52abeda57687507f1c","text":"Calm down.","speaker":""},{"id":"other-message-p7486-cdc1c8bd789252c09e91","text":"Take your time, okay?","speaker":""},{"id":"other-message-p7486-6321a7030d611036bd6f","text":"It's something super urgent!","speaker":"Pom-Pom"},{"id":"other-message-p7486-e7975f5f4d169e306c96","text":"Pom-Pom doesn't even want to think about it...","speaker":"Pom-Pom"},{"id":"other-message-p7486-36186f9c60d2ac235a24","text":"The train's long overdue cleaning day is almost upon us! Aaaaahhh!","speaker":"Pom-Pom"},{"id":"other-message-p7486-7d2535d6684b47134bdd","text":"...Huh?","speaker":""},{"id":"other-message-p7486-94d52e5df89284208354","text":"I get it now.","speaker":""},{"id":"other-message-p7486-0dce15be793c473d34c8","text":"So, you want me to come back and help you with the cleaning?","speaker":""},{"id":"other-message-p7486-6a3c2ab7fc37408b53d1","text":"But if you're willing to lend a hand, [Trailblazer], that would be great!","speaker":"Pom-Pom"},{"id":"other-message-p7486-fe21d4243683bfb740c9","text":"We're on our way to the nearest Washtopia.","speaker":"Pom-Pom"},{"id":"other-message-p7486-f20f82ad6c2c2d1d1b74","text":"Come back and see me when you have time!","speaker":"Pom-Pom"}]}
