{"schema":"hsr-localizations.v1","entryId":"other-message-p7469","chapterId":"s91d7c0d5f171b0dc","language":"en","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"other-message-p7469-627d88273bd9f2c9a04a","text":"How are the photos?","speaker":"March 7th"},{"id":"other-message-p7469-e8089e12222f0966d006","text":"(Show photo)","speaker":""},{"id":"other-message-p7469-16327afa88a256a3ef46","text":"Thank you, [Trailblazer]!","speaker":"March 7th"},{"id":"other-message-p7469-18ad28b872600988d0ff","text":"Nice photo, right?","speaker":""},{"id":"other-message-p7469-43c493dd713099a2a97b","text":"Nice photo, right?","speaker":""},{"id":"other-message-p7469-8de2e7ec1d4aaab34ea2","text":"Hey, you're indeed talented.","speaker":"March 7th"},{"id":"other-message-p7469-9c746ab2c6bdbe701a46","text":"Don't think that's the best photo...","speaker":""},{"id":"other-message-p7469-fb0d65391aad475c1915","text":"Doesn't look great to me...","speaker":""},{"id":"other-message-p7469-c4518dec9592701d86ad","text":"That's fine, it's already great!","speaker":"March 7th"},{"id":"other-message-p7469-dd4447b210f112056483","text":"Great job. I'll send you new pics tomorrow!","speaker":"March 7th"},{"id":"other-message-p7469-a5bf582366b8dc04d98d","text":"I'll be waiting for your good news!","speaker":"March 7th"}]}
