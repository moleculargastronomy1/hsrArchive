{"schema":"hsr-localizations.v1","entryId":"other-message-p7469","chapterId":"s53824dc10ebee38c","language":"en","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"other-message-p7469-83d7e931e50ac0b99f75","text":"Where are you","speaker":"March 7th"},{"id":"other-message-p7469-3b45925626a8392ebf08","text":"Miss Black Swan is about to say goodbye to us","speaker":"March 7th"},{"id":"other-message-p7469-95a4e321c6f38db4f6fc","text":"Is she leaving?","speaker":""},{"id":"other-message-p7469-ab5ad3ab5329ced75c32","text":"She's leaving?","speaker":""},{"id":"other-message-p7469-48206071cf7c3f69b5e4","text":"Oh, just come over! Hurry!","speaker":"March 7th"}]}
