{"schema":"hsr-localizations.v1","entryId":"other-message-p7469","chapterId":"scc6b79b93c1c60d1","language":"en","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"other-message-p7469-fad55482901d7ee84dc0","text":"Did you take today's photos?","speaker":"March 7th"},{"id":"other-message-p7469-77faabfe70f725d0d83b","text":"[Trailblazer], you there?","speaker":"March 7th"},{"id":"other-message-p7469-33b147b28ad4720d636d","text":"(Show photo)","speaker":""},{"id":"other-message-p7469-7295d558282437937dac","text":"Got hit by a tram","speaker":""},{"id":"other-message-p7469-71a909b41b1570e22eff","text":"I just got hit by a tram and went flying","speaker":""},{"id":"other-message-p7469-d3481bd6e4c284e1b05b","text":"Luckily I maxed out my DEF and didn't get hurt","speaker":""},{"id":"other-message-p7469-e09f7e025a70700ce32b","text":"!","speaker":"March 7th"},{"id":"other-message-p7469-6522ea1e398144625465","text":"Take care of yourself!","speaker":"March 7th"},{"id":"other-message-p7469-57fc2ae5f03db1c3e1eb","text":"I was fighting","speaker":""},{"id":"other-message-p7469-1f01710e16bf8e32bb70","text":"I was just in a fight","speaker":""},{"id":"other-message-p7469-30a2c7517481a3a8e43e","text":"There's an enemy that looked just like a tram","speaker":""},{"id":"other-message-p7469-e37fb638c771a147f5f7","text":"That kind of enemy exists? Curious!","speaker":"March 7th"},{"id":"other-message-p7469-ac414cafc7a1f8fbbb7c","text":"Let's take more pics next time, and you can show your pics to me!","speaker":"March 7th"},{"id":"other-message-p7469-a9e771b459f51d14eeb7","text":"I was too into taking pics","speaker":""},{"id":"other-message-p7469-eed6e94ab9368710ea6e","text":"I got too into my photography just then","speaker":""},{"id":"other-message-p7469-f19665b41e0b06e134c9","text":"You love photography that much?","speaker":"March 7th"},{"id":"other-message-p7469-ce83a64062b7d709e50a","text":"You can keep taking photos with me in future trips","speaker":"March 7th"}]}
