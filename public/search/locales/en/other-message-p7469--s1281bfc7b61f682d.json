{"schema":"hsr-localizations.v1","entryId":"other-message-p7469","chapterId":"s1281bfc7b61f682d","language":"en","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"other-message-p7469-d1da3756cc8e299ddcc3","text":"Where are you","speaker":"March 7th"},{"id":"other-message-p7469-863b5745c8078a94fbc3","text":"There's a gift for you, come quick","speaker":"March 7th"},{"id":"other-message-p7469-e8caca81b52e15dd6993","text":"Gift?","speaker":""},{"id":"other-message-p7469-be96bf46da4f1cd649a5","text":"...What gift?","speaker":""},{"id":"other-message-p7469-c1b443a11afe5dd11e27","text":"Oh, just come over","speaker":"March 7th"},{"id":"other-message-p7469-5df0be6723b8bb3dbebc","text":"Someone's making a sparkly return today. You haven't forgotten that, have you?","speaker":"March 7th"},{"id":"other-message-p7469-fed23dccdbba25d6af7d","text":"...Who's that?","speaker":""},{"id":"other-message-p7469-9bcc7493679138151ff2","text":"Sparkle?","speaker":""},{"id":"other-message-p7469-09ff51bb2c1369f2ac80","text":"Sparkly... Sparkle?","speaker":""}]}
