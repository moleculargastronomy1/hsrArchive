{"schema":"hsr-dialogue.v1","entryId":"books-luofu","chapterId":"book-190457","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","textReferenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","sourceIds":["LocalbookConfig:190457","BookSeriesConfig:225"],"orderNote":"BookSeriesID, BookSeriesInsideID order; collection state is not inferred.","book":{"id":190457,"seriesId":225,"volume":1,"bookshelf":true,"hasImages":false},"rows":[{"id":"books-luofu-book-190457","entryId":"books-luofu","chapterId":"book-190457","missionId":"book-series-225","mission":"대역죄인 음월 판결 문서","scene":"대역죄인 음월 판결 문서","speaker":"","type":"narration","text":"죄인 단풍은 법을 어기고\n불사의 몸을 얻기 위해 난을 일으켜\n신과 인간에게 용서받을 수 없는 범죄를 저질렀으므로\n사형에 처한다.\n\n이제\n옛 공적을 고려하여 사형을 면하고\n죄를 감면하여 윤회 탈피의 형을 내린 후\n화외로 추방하였으니\n나부의 어떤 곳에도 발을 들일 수 없다.","talkId":null,"textHash":"10526294784203772463","source":"LocalbookConfig:190457/BookContent"}]}
