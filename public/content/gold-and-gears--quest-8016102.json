{"schema":"hsr-dialogue.v1","entryId":"gold-and-gears","chapterId":"quest-8016102","referenceCommit":"a66ec9c36e3321ce4ea9e62b58e9326634628dce","sourceIds":["quest-8016102"],"missing":0,"orderNote":"자료의 참조 순서입니다. 선택지와 분기는 모두 수록하며 실제 플레이 순서와 다를 수 있습니다.","rows":[{"id":"gold-and-gears-quest-8016102-quest-8016102-0","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"헤르타","text":"돌아왔어? 느낌은 어때?","talkId":403060041,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-1","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"choice","speaker":"화자 미지정","text":"재미있었어요","talkId":403060042,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-2","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"choice","speaker":"화자 미지정","text":"이전과 비슷해요","talkId":403060044,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-3","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"choice","speaker":"화자 미지정","text":"근데 곁에 계신 분은……","talkId":403060046,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-4","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"헤르타","text":"당연하지","talkId":403060043,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-5","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"헤르타","text":"그래? 스티븐에게 피드백해 줘","talkId":403060045,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-6","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"헤르타","text":"소개해줄게. 컴퍼니 전략투자부에서 온 손님이야","talkId":403060047,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-7","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"소형 로봇","text":"[개척자], 안녕하세요. 저는 P-45 「펄」 아가씨의 위임을 받아 전략투자부 대표로 헤르타 씨와 협업을 논의하러 왔습니다","talkId":403060048,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-8","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"소형 로봇","text":"시뮬레이션 우주의 다음 연구 방향은 「제1차 제왕 전쟁」이라고 들었습니다. 그때는 「변방 행성 무역 전쟁」의 시대이기도 해서 펄 아가씨도 관심이 무척 많으십니다","talkId":403060049,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-9","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"소형 로봇","text":"전략투자부는 컴퍼니의 수많은 조직 중 비교적 젊은 부서여서, 그 시대를 겪어보지 못했습니다. 지금 부서의 엘리트들은 은하를 돌아다니며 「만계의 암」으로 인한 각종 악성 부채를 청산하고 있는데, 이를 위해 더 많은 역사적 사실과 관련된 자료가 필요합니다","talkId":403060050,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-10","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"소형 로봇","text":"저희는 시뮬레이션 우주 프로젝트를 지원할 의사가 있으며, 컴퍼니와 관련된 연역 데이터를 구매하고 싶습니다","talkId":403060051,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-11","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"choice","speaker":"화자 미지정","text":"「펄」이 누구죠?","talkId":403060052,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-12","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"choice","speaker":"화자 미지정","text":"시뮬레이션 우주가 그렇게 유명해요?","talkId":403060054,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-13","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"헤르타","text":"몰라. 스크루룸이 언급한 적이 있는 것 같은데, 아마도 지능 기계겠지","talkId":403060053,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-14","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"헤르타","text":"당연한 거 아니야?","talkId":403060055,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-15","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"헤르타","text":"솔직히 말하자면 제왕 전쟁은 너무 오래된 역사라 현재의 투자 업무에 별로 도움이 될 것 같지는 않아. 그들이 사무실에 앉아 있는 게 너무 심심해서 컴퍼니가 설립될 당시의 가십거리가 궁금한 게 아니라면 말이지","talkId":403060056,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-16","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"헤르타","text":"또는—— 아니야. 난 비즈니스 싸움에는 관심 없거든","talkId":403060057,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-17","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 돌아왔어? 느낌은 어때?","type":"dialogue","speaker":"헤르타","text":"저들이 돈을 내고 싶다고 하니 굳이 막을 이유는 없지. 이 일은 재미있어 보여서 승낙했어. 그러니까 힘내서 컴퍼니의 비화를 모아줘","talkId":403060058,"source":"Config/Level/Mission/8016102/Act/Act403060040.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-18","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 「[개척자], 환영해. 스티븐은 네게 반드시 『사용자 정의…","type":"dialogue","speaker":"헤르타","text":"「[개척자], 환영해. 스티븐은 네게 반드시 『사용자 정의 주사위』에 대해 자세히 설명해 주라고 했어」 헤르타는 자세히 설명하고픈 눈치가 아닌 듯했다. 「스티븐은 『사용자 정의 주사위』가 지능 기계를 배양하는 껍데기라고 했어. 『감정』, 『사고』, 『기억』, 『매력』 등을 주사위에 부착할 수 있지」","talkId":403060201,"source":"Config/Level/Mission/8016102/Act/Act403060200.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-19","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 「[개척자], 환영해. 스티븐은 네게 반드시 『사용자 정의…","type":"choice","speaker":"화자 미지정","text":"그러니까 이 주사위가 지능 기계라는 건가요?","talkId":403060202,"source":"Config/Level/Mission/8016102/Act/Act403060200.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-20","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 「[개척자], 환영해. 스티븐은 네게 반드시 『사용자 정의…","type":"choice","speaker":"화자 미지정","text":"그냥 조립형 주사위잖아요……","talkId":403060204,"source":"Config/Level/Mission/8016102/Act/Act403060200.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-21","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 「[개척자], 환영해. 스티븐은 네게 반드시 『사용자 정의…","type":"dialogue","speaker":"헤르타","text":"「몰라」 헤르타가 어깨를 으쓱했다. 「그냥 가지고 놀면 돼. 어쩌면 언젠가 자유 의지가 생겨날지도 모르지」","talkId":403060203,"source":"Config/Level/Mission/8016102/Act/Act403060200.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-22","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 「[개척자], 환영해. 스티븐은 네게 반드시 『사용자 정의…","type":"dialogue","speaker":"헤르타","text":"「응, 맞아」 헤르타가 입을 열었다. 「그냥 가지고 놀면 돼. 오류 제보할 게 있으면 스티븐에게 전해주면 되고」","talkId":403060205,"source":"Config/Level/Mission/8016102/Act/Act403060200.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-23","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 「[개척자], 환영해. 스티븐은 네게 반드시 『사용자 정의…","type":"dialogue","speaker":"헤르타","text":"「힘내! 계속 전진하는 거야, [개척자]」 말을 마친 헤르타가 화면을 껐다","talkId":403060206,"source":"Config/Level/Mission/8016102/Act/Act403060200.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-24","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"dialogue","speaker":"헤르타","text":"응?","talkId":403060241,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-25","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"choice","speaker":"화자 미지정","text":"「곤충 떼 재난」에 대해…","talkId":403060242,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-26","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"choice","speaker":"화자 미지정","text":"「황금과 기계」에 대해…","talkId":403060247,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-27","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"choice","speaker":"화자 미지정","text":"아니요. 가 볼게요","talkId":403011235,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-28","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"dialogue","speaker":"헤르타","text":"무슨 의혹?","talkId":403060243,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-29","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"choice","speaker":"화자 미지정","text":"「번식」의 비밀을 어떻게 알아내야 하죠?","talkId":403060244,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-30","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"choice","speaker":"화자 미지정","text":"궁금한 게 더 있어요…","talkId":403060246,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-31","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"dialogue","speaker":"헤르타","text":"「행자의 길」을 실행하면 돼. 먼저 이 길을 걸었던 사람들의 행적을 따라가며 에이언즈에 접근하는 거야! 걱정 마, 자신의 성격에 따라 운명의 길을 걸으면 되니까","talkId":403060245,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-32","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"dialogue","speaker":"헤르타","text":"뭔데?","talkId":403060248,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-33","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"choice","speaker":"화자 미지정","text":"「지식」의 비밀을 어떻게 알아내야 하죠?","talkId":403060249,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-34","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"choice","speaker":"화자 미지정","text":"궁금한 게 더 있어요…","talkId":403060251,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-35","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"dialogue","speaker":"헤르타","text":"흠, 좋은 질문이야. 항상 자신의 「자아인지」에 주의해. 로봇이 되지 않도록. 안 그럼 이성을 완전히 잃어버릴 거야. 복잡하게 생각할 거 없어. 넌 어차피 그의 계산대로 움직이게 될 거니까","talkId":403060250,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"},{"id":"gold-and-gears-quest-8016102-quest-8016102-36","entryId":"gold-and-gears","chapterId":"quest-8016102","missionId":"quest-8016102","mission":"황금과 기계: 실험 튜토리얼","scene":"헤르타 · 응?","type":"dialogue","speaker":"헤르타","text":"내 「시뮬레이션 우주」를 테스트해 보는 거 잊지 마!","talkId":403011236,"source":"Config/Level/Mission/8016102/Act/Act403060240.json"}]}