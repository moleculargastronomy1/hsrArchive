6101-quest-8016101-5"],"bwikiPage":"黄金与机械：开启","bwikiRevision":96772,"bwikiMissionId":"quest-8016101","bwikiMission":"황금과 기계: 시작"},{"id":"gold-and-gears-quest-8016101-quest-8016101-3","entryId":"gold-and-gears","chapterId":"quest-8016101","missionId":"quest-8016101","mission":"황금과 기계: 시작","scene":"헤르타 · [개척자], 시뮬레이션 우주를 업데이트했어. 「확장 장치」…","type":"choice","speaker":"화자 미지정","text":"재미있는 게 있나요?","talkId":403060008,"source":"Config/Level/Mission/8016101/Act/Act403060000.json","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"8dfb08844ce8e493","bwikiNextIds":["gold-and-gears-quest-8016101-quest-8016101-9"],"bwikiPage":"黄金与机械：开启","bwikiRevision":96772,"bwikiMissionId":"quest-8016101","bwikiMission":"황금과 기계: 시작"},{"id":"gold-and-gears-quest-8016101-quest-8016101-5","entryId":"gold-and-gears","chapterId":"quest-8016101","missionId":"quest-8016101","mission":"황금과 기계: 시작","scene":"헤르타 · [개척자], 시뮬레이션 우주를 업데이트했어. 「확장 장치」…","type":"dialogue","speaker":"헤르타","text":"#27 루버트, 클럽에서 내가 가장 관심 있는 녀석 중 하나야. 스스로를 제왕이라고 칭하며 우주의 모두가 알고 있는 기계제국의 위기, 「제1차 제왕 전쟁」을 일으킨 장본인이지","talkId":403060004,"source":"Config/Level/Mission/8016101/Act/Act403060000.json","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"8dfb08844ce8e493","bwikiNextIds":["gold-and-gears-quest-8016101-quest-8016101-6"],"bwikiPage":"黄金与机械：开启","bwikiRevision":96772,"bwikiMissionId":"quest-8016101","bwikiMission":"황금과 기계: 시작","bwikiReplyToIds":["gold-and-gears-quest-8016101-quest-8016101-2"]},{"id":"gold-and-gears-quest-8016101-quest-8016101-6","entryId":"gold-and-gears","chapterId":"quest-8016101","missionId":"quest-8016101","mission":"황금과 기계: 시작","scene":"헤르타 · [개척자], 시뮬레이션 우주를 업데이트했어. 「확장 장치」…","type":"dialogue","speaker":"헤르타","text":"이번에 완•매는 「누스」를 육성하고 싶어 했고, 스크루룸은 줄곧 무기 생명체의 기원에 대해 관심이 많았지. 그래서 우리는 #27 루버트의 사망 전 시간을 선택하기로 단번에 합의했어","talkId":403060005,"source":"Config/Level/Mission/8016101/Act/Act403060000.json","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"8dfb08844ce8e493","bwikiNextIds":["gold-and-gears-quest-8016101-quest-8016101-7"],"bwikiPage":"黄金与机械：开启","bwikiRevision":96772,"bwikiMissionId":"quest-8016101","bwikiMission":"황금과 기계: 시작"},{"id":"gold-and-gears-quest-8016101-quest-8016101-7","entryId":"gold-and-gears","chapterId":"quest-8016101","missionId":"quest-8016101","mission":"황금과 기계: 시작","scene":"헤르타 · [개척자], 시뮬레이션 우주를 업데이트했어. 「확장 장치」…","type":"dialogue","speaker":"헤르타","text":"첫 단계는 「계산」, 「로직」 등 개념을 체계적으로 추출하고 정리하여 무기 생명체와 관련된 내용을 선별하는 거야","talkId":403060006,"source":"Config/Level/Mission/8016101/Act/Act403060000.json","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"8dfb08844ce8e493","bwikiNextIds":["gold-and-gears-quest-8016101-quest-8016101-8"],"bwikiPage":"黄金与机械：开启","bwikiRevision":96772,"bwikiMissionId":"quest-8016101","bwikiMission":"황금과 기계: 시작"},{"id":"gold-and-gears-quest-8016101-quest-8016101-8","entryId":"gold-and-gears","chapterId":"quest-8016101","missionId":"quest-8016101","mission":"황금과 기계: 시작","scene":"헤르타 · [개척자], 시뮬레이션 우주를 업데이트했어. 「확장 장치」…","type":"dialogue","speaker":"헤르타","text":"이따 너무 놀라지는 마. 곧 우주 로봇 머리의 역사를 목격하게 될 테니까","talkId":403060007,"source":"Config/Level/Mission/8016101/Act/Act403060000.json","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"8dfb08844ce8e493","bwikiNextIds":[],"bwikiPage":"黄金与机械：开启","bwikiRevision":96772,"bwikiMissionId":"quest-8016101","bwikiMission":"황금과 기계: 시작"},{"id":"gold-and-gears-quest-8016101-quest-8016101-9","entryId":"gold-and-gears","chapterId":"quest-8016101","missionId":"quest-8016101","mission":"황금과 기계: 시작","scene":"헤르타 · [개척자], 시뮬레이션 우주를 업데이트했어. 「확장 장치」…","type":"dialogue","speaker":"헤르타","text":"해 보면 알아. 실물 없이 내가 말하는 걸 듣기만 하는 건 의미가 없으니까, 안 그래?","talkId":403060009,"source":"Config/Level/Mission/8016101/Act/Act403060000.json","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"8dfb08844ce8e493","bwikiNextIds":[],"bwikiPage":"黄金与机械：开启","bwikiRevision":96772,"bwikiMissionId":"quest-8016101","bwikiMission":"황금과 기계: 시작","bwikiReplyToIds":["gold-and-gears-quest-8016