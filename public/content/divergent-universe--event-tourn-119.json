atus":"review","bwikiStatus":"cached","bwikiScene":"788395d004b5420e","bwikiNextIds":["divergent-universe-event-tourn-119-text-3576702563600281130-effect"],"bwikiPage":"跳蚤市场","bwikiRevision":97790,"bwikiMissionId":"bwiki-page-13808","bwikiMission":"벼룩시장"},{"id":"divergent-universe-event-tourn-119-text-3576702563600281130-effect","entryId":"divergent-universe","chapterId":"event-tourn-119","missionId":"event-tourn-119","mission":"벼룩시장","scene":"벼룩시장","type":"narration","speaker":"","text":"우주 조각을 제출한다","talkId":null,"textHash":"3576702563600281130","source":"tournHandBookEvent:119/text-3576702563600281130","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"788395d004b5420e","bwikiNextIds":[],"bwikiPage":"跳蚤市场","bwikiRevision":97790,"bwikiMissionId":"bwiki-page-13808","bwikiMission":"벼룩시장","bwikiReplyToIds":["divergent-universe-event-tourn-119-text-3892576449541471713-choice"]},{"id":"divergent-universe-event-tourn-119-text-18288326102997898319-choice","entryId":"divergent-universe","chapterId":"event-tourn-119","missionId":"event-tourn-119","mission":"벼룩시장","scene":"벼룩시장","type":"choice","speaker":"","text":"어젯밤의 꿈","talkId":null,"textHash":"18288326102997898319","source":"tournHandBookEvent:119/text-18288326102997898319","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"1b230844b98f1310","bwikiNextIds":[],"bwikiPage":"跳蚤市场","bwikiRevision":97790,"bwikiMissionId":"bwiki-page-13808","bwikiMission":"벼룩시장"},{"id":"divergent-universe-event-tourn-119-talk-403816555-line","entryId":"divergent-universe","chapterId":"event-tourn-119","missionId":"event-tourn-119","mission":"벼룩시장","scene":"벼룩시장","type":"dialogue","speaker":"시뮬레이션 우주","text":"음유시인은 눈을 살짝 감았고, 당신은 고요한 바다에 잠겼다. 음표는 물방울이요, 노랫소리는 물의 흐름이니, 이야기가 물줄기를 따라 당신의 가슴에 스며든다","talkId":403816555,"textHash":"5422157678671001638","source":"tournHandBookEvent:119/talk-403816555","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"9458316e464c1831","bwikiNextIds":["divergent-universe-event-tourn-119-talk-403816556-line"],"bwikiPage":"跳蚤市场","bwikiRevision":97790,"bwikiMissionId":"bwiki-page-13808","bwikiMission":"벼룩시장"},{"id":"divergent-universe-event-tourn-119-talk-403816556-line","entryId":"divergent-universe","chapterId":"event-tourn-119","missionId":"event-tourn-119","mission":"벼룩시장","scene":"벼룩시장","type":"dialogue","speaker":"시뮬레이션 우주","text":"당신은 만 년 동안 멈추지 않는 춤, 곤돌라에서 우는 광대들, 하늘에서 내리는 다이아몬드 비를 보았다. 소란 속에서 당신의 세계로 돌아오니, 음유시인은 이미 자취를 감춘 뒤였다. 그는 자기 말대로 당신의 시를 가지고 갔다","talkId":403816556,"textHash":"10614740778923604998","source":"tournHandBookEvent:119/talk-403816556","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"9458316e464c1831","bwikiNextIds":[],"bwikiPage":"跳蚤市场","bwikiRevision":97790,"bwikiMissionId":"bwiki-page-13808","bwikiMission":"벼룩시장"}],"orderNote":"공식 사건 도감에 귀속된 한국어 원문입니다. BWIKI에서 확인한 모드별 구간만 연결하며 조건·확률·미확인 경계는 이어 붙이지 않습니다.","bwikiBaseOrder":["divergent-universe-event-tourn-119-talk-403816550-line","divergent-universe-event-tourn-119-talk-403816551-line","divergent-universe-event-tourn-119-talk-403816552-line","divergent-universe-event-tourn-119-talk-403816553-line","divergent-universe-event-tourn-119-text-1869401699070440945-choice","divergent-universe-event-tourn-119-text-11305856290418073952-effect","divergent-universe-event-tourn-119-text-14104017414082285654-choice","divergent-universe-event-tourn-119-text-6132995357496605747-choice","divergent-universe-event-tourn-119-text-8392135967272805539-choice","divergent-universe-event-tourn-119-text-14507658815805546499-effect","divergent-universe-event-tourn-119-text-11885915246953576131-choice","divergent-universe-event-tourn-119-text-13794169222018938135-choice","divergent-universe-event-tourn-119-text-3892576449541471713-choice","divergent-universe-event-tourn-119-text-3576702563600281130-effect","divergent-universe-event-tourn-119-text-18288326102997898319-choice","divergent-universe-event-tourn-119-talk-403816555-line","divergent-universe-event-tourn-119-talk-403816556-line"],"bwiki":{"m