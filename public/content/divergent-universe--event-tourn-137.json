{"schema":"hsr-dialogue.v1","entryId":"divergent-universe","chapterId":"event-tourn-137","referenceCommit":"312b4597691e0a29cf9828a15b592757dba86949","textReferenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","sourceIds":["event-tourn-137"],"missing":0,"rows":[{"id":"divergent-universe-event-tourn-137-talk-403817140-line","entryId":"divergent-universe","chapterId":"event-tourn-137","missionId":"event-tourn-137","mission":"거울 속 탈출","scene":"거울 속 탈출","type":"dialogue","speaker":"시뮬레이션 우주","text":"에포스의 절벽 아래, 광기에 빠진 티탄 권속과 괴물이 당신을 바짝 뒤쫓고 있다","talkId":403817140,"textHash":"13257545477188295926","source":"tournHandBookEvent:137/talk-403817140","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"7505f580312dd105","bwikiNextIds":["divergent-universe-event-tourn-137-talk-403817141-line"],"bwikiPage":"镜里逃生","bwikiRevision":96783,"bwikiMissionId":"bwiki-page-18010","bwikiMission":"거울 속 탈출"},{"id":"divergent-universe-event-tourn-137-talk-403817141-line","entryId":"divergent-universe","chapterId":"event-tourn-137","missionId":"event-tourn-137","mission":"거울 속 탈출","scene":"거울 속 탈출","type":"dialogue","speaker":"시뮬레이션 우주","text":"무너진 보루가 골짜기의 허리를 끊어 놓았다. 경계가 모호해진 조각상으로 보아 한때 만 갈래의 문을 신봉하던 어떤 도시 국가의 것이었음을 어렴풋이 알 수 있다","talkId":403817141,"textHash":"18151303847281247081","source":"tournHandBookEvent:137/talk-403817141","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"7505f580312dd105","bwikiNextIds":["divergent-universe-event-tourn-137-talk-403817142-line"],"bwikiPage":"镜里逃生","bwikiRevision":96783,"bwikiMissionId":"bwiki-page-18010","bwikiMission":"거울 속 탈출"},{"id":"divergent-universe-event-tourn-137-talk-403817142-line","entryId":"divergent-universe","chapterId":"event-tourn-137","missionId":"event-tourn-137","mission":"거울 속 탈출","scene":"거울 속 탈출","type":"dialogue","speaker":"시뮬레이션 우주","text":"당신은 파괴된 담벼락을 오가며 부서진 조각상과 제단에서 통로를 찾고자 했다. 그러나 석문에 있는 거대한 거울이 당신의 앞길을 막아섰다. 「이 문 너머로 들어가려는 자여, 한 줄기 희망을 품으라」","talkId":403817142,"textHash":"14327949150046146645","source":"tournHandBookEvent:137/talk-403817142","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"7505f580312dd105","bwikiNextIds":["divergent-universe-event-tourn-137-talk-403817143-line"],"bwikiPage":"镜里逃生","bwikiRevision":96783,"bwikiMissionId":"bwiki-page-18010","bwikiMission":"거울 속 탈출"},{"id":"divergent-universe-event-tourn-137-talk-403817143-line","entryId":"divergent-universe","chapterId":"event-tourn-137","missionId":"event-tourn-137","mission":"거울 속 탈출","scene":"거울 속 탈출","type":"dialogue","speaker":"시뮬레이션 우주","text":"당신은 거울의 조언을 생각할 겨를도 없이 야누스의 이름을 되뇌며 거울 속으로 뛰어들었다","talkId":403817143,"textHash":"11903945718599223144","source":"tournHandBookEvent:137/talk-403817143","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"7505f580312dd105","bwikiNextIds":[],"bwikiPage":"镜里逃生","bwikiRevision":96783,"bwikiMissionId":"bwiki-page-18010","bwikiMission":"거울 속 탈출"},{"id":"divergent-universe-event-tourn-137-text-15425799155530778405-choice","entryId":"divergent-universe","chapterId":"event-tourn-137","missionId":"event-tourn-137","mission":"거울 속 탈출","scene":"거울 속 탈출","type":"choice","speaker":"","text":"소란스러운 방향으로 헤엄친다","talkId":null,"textHash":"15425799155530778405","source":"tournHandBookEvent:137/text-15425799155530778405","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"55c14b3bdf01ed54","bwikiNextIds":["divergent-universe-event-tourn-137-text-13996721010137901253-effect"],"bwikiPage":"镜里逃生","bwikiRevision":96783,"bwikiMissionId":"bwiki-page-18010","bwikiMission":"거울 속 탈출"},{"id":"divergent-universe-event-tourn-137-text-13996721010137901253-effect","entryId":"divergent-universe","chapterId":"event-tourn-137","missionId":"event-tourn-137","mission":"거울 속 탈출","scene":"거울 속 탈출","type":"narration","speaker":"","text":"석경 효과 획득: [전투] 또는 [사건] 구역 진입 시 발동","talkId":null,"textHash":"13996721010137901253","source":"tournHandBookEvent:137/text-13996721010137901253","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"55c14b3bdf01ed54","bwikiNextIds":[