d","bwikiScene":"cf1ee12b1cf1dd24","bwikiNextIds":[],"bwikiPage":"特别优惠","bwikiRevision":96716,"bwikiMissionId":"bwiki-page-13813","bwikiMission":"특별 할인"},{"id":"divergent-universe-event-tourn-106-text-9057529563354635015-choice","entryId":"divergent-universe","chapterId":"event-tourn-106","missionId":"event-tourn-106","mission":"특별 할인","scene":"특별 할인","type":"choice","speaker":"","text":"너무 비싸다","talkId":null,"textHash":"9057529563354635015","source":"tournHandBookEvent:106/text-9057529563354635015","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"cac8627e167eb0f0","bwikiNextIds":["divergent-universe-event-tourn-106-text-17240493615890863073-effect"],"bwikiPage":"特别优惠","bwikiRevision":96716,"bwikiMissionId":"bwiki-page-13813","bwikiMission":"특별 할인"},{"id":"divergent-universe-event-tourn-106-text-17240493615890863073-effect","entryId":"divergent-universe","chapterId":"event-tourn-106","missionId":"event-tourn-106","mission":"특별 할인","scene":"특별 할인","type":"narration","speaker":"","text":"당신은 떠나기로 한다","talkId":null,"textHash":"17240493615890863073","source":"tournHandBookEvent:106/text-17240493615890863073","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"cac8627e167eb0f0","bwikiNextIds":["divergent-universe-event-tourn-106-talk-403816113-line"],"bwikiPage":"特别优惠","bwikiRevision":96716,"bwikiMissionId":"bwiki-page-13813","bwikiMission":"특별 할인","bwikiReplyToIds":["divergent-universe-event-tourn-106-text-9057529563354635015-choice"]},{"id":"divergent-universe-event-tourn-106-talk-403816113-line","entryId":"divergent-universe","chapterId":"event-tourn-106","missionId":"event-tourn-106","mission":"특별 할인","scene":"특별 할인","type":"dialogue","speaker":"시뮬레이션 우주","text":"언젠가 자판기가 제발 물건 좀 사달라고 애원하게 되는 날이 올 것이다","talkId":403816113,"textHash":"4028553065020257162","source":"tournHandBookEvent:106/talk-403816113","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"cac8627e167eb0f0","bwikiNextIds":[],"bwikiPage":"特别优惠","bwikiRevision":96716,"bwikiMissionId