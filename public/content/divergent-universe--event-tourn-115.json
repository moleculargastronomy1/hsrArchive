{"schema":"hsr-dialogue.v1","entryId":"divergent-universe","chapterId":"event-tourn-115","referenceCommit":"312b4597691e0a29cf9828a15b592757dba86949","textReferenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","sourceIds":["event-tourn-115"],"missing":0,"rows":[{"id":"divergent-universe-event-tourn-115-talk-403816580-line","entryId":"divergent-universe","chapterId":"event-tourn-115","missionId":"event-tourn-115","mission":"콜라보 제품","scene":"콜라보 제품","type":"dialogue","speaker":"시뮬레이션 우주","text":"시끌벅적한 스타 백화점, 뽑기 기계가 여봐란듯이 당신의 앞에 나타났다. 화려한 조명, 가슴을 찢는 듯한 음악, 무수한 신발 자국이 이 기계가 여기서 얼마나 인기가 많은지 알려준다","talkId":403816580,"textHash":"11267767579184835301","source":"tournHandBookEvent:115/talk-403816580","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"e09fb02dee0c6242","bwikiNextIds":["divergent-universe-event-tourn-115-talk-403816581-line"],"bwikiPage":"联名产品","bwikiRevision":95871,"bwikiMissionId":"bwiki-page-13814","bwikiMission":"콜라보 제품"},{"id":"divergent-universe-event-tourn-115-talk-403816581-line","entryId":"divergent-universe","chapterId":"event-tourn-115","missionId":"event-tourn-115","mission":"콜라보 제품","scene":"콜라보 제품","type":"dialogue","speaker":"시뮬레이션 우주","text":"「지식학회 콜라보 한정판 뽑기, 지금 당장 만나보세요」 이런 걸 원하는 사람이 정말 있긴 할까? 당신은 뽑기 기계에 머리를 대고 아는 사람의 굿즈가 있는지 확인한다","talkId":403816581,"textHash":"8980080363833102663","source":"tournHandBookEvent:115/talk-403816581","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"e09fb02dee0c6242","bwikiNextIds":["divergent-universe-event-tourn-115-talk-403816582-line"],"bwikiPage":"联名产品","bwikiRevision":95871,"bwikiMissionId":"bwiki-page-13814","bwikiMission":"콜라보 제품"},{"id":"divergent-universe-event-tourn-115-talk-403816582-line","entryId":"divergent-universe","chapterId":"event-tourn-115","missionId":"event-tourn-115","mission":"콜라보 제품","scene":"콜라보 제품","type":"dialogue","speaker":"시뮬레이션 우주","text":"「시험 삼아 한번 해보시죠?」 뽑기 기계가 당신의 속마음을 말로 표현했다","talkId":403816582,"textHash":"7734099796249531010","source":"tournHandBookEvent:115/talk-403816582","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"e09fb02dee0c6242","bwikiNextIds":[],"bwikiPage":"联名产品","bwikiRevision":95871,"bwikiMissionId":"bwiki-page-13814","bwikiMission":"콜라보 제품"},{"id":"divergent-universe-event-tourn-115-text-16597175819054148068-choice","entryId":"divergent-universe","chapterId":"event-tourn-115","missionId":"event-tourn-115","mission":"콜라보 제품","scene":"콜라보 제품","type":"choice","speaker":"","text":"짜릿한 게 최고지","talkId":null,"textHash":"16597175819054148068","source":"tournHandBookEvent:115/text-16597175819054148068","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"dac78251fce1a443","bwikiNextIds":[],"bwikiPage":"联名产品","bwikiRevision":95871,"bwikiMissionId":"bwiki-page-13814","bwikiMission":"콜라보 제품"},{"id":"divergent-universe-event-tourn-115-text-16522073240195360112-choice","entryId":"divergent-universe","chapterId":"event-tourn-115","missionId":"event-tourn-115","mission":"콜라보 제품","scene":"콜라보 제품","type":"choice","speaker":"","text":"학회의 사업을 도와주는 셈 치자","talkId":null,"textHash":"16522073240195360112","source":"tournHandBookEvent:115/text-16522073240195360112","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"dbf2437c177d3ded","bwikiNextIds":[],"bwikiPage":"联名产品","bwikiRevision":95871,"bwikiMissionId":"bwiki-page-13814","bwikiMission":"콜라보 제품"},{"id":"divergent-universe-event-tourn-115-text-347307584445858792-choice","entryId":"divergent-universe","chapterId":"event-tourn-115","missionId":"event-tourn-115","mission":"콜라보 제품","scene":"콜라보 제품","type":"choice","speaker":"","text":"떠난다","talkId":null,"textHash":"347307584445858792","source":"tournHandBookEvent:115/text-347307584445858792","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"b29a49b3518f5cc4","bwikiNextIds":["divergent-universe-event-tourn-115-text-17278767016848671934-effect"],"bwikiPage":"联名产品","bwikiRevision":95871,"bwikiMissionId":"bwiki-page-13814","bwikiMission":"콜라보 제품"},{"id":"divergent-universe-event-tourn-115-text-17278767016848671934-effect","entryId":"divergent-universe","chapterId":"event-tourn-115","missionId":"event-tourn-115","mission":"콜라보 제품","scene":"콜라보 제품","type":"narration","speaker":"","text":"떠난다","talkId":null,"textHash":"17278767016848671934","source":"tournHandBookEvent:115/text-17278767016848671934","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"b29a49b3518f5cc4","bwikiNextIds":[],"bwikiPage":"联名产品","bwikiRevision":95871,"bwikiMissionId":"bwiki-page-13814","bwikiMission":"콜라보 제품","bwikiReplyToIds":["divergent-universe-event-tourn-115-text-347307584445858792-choice"]},{"id":"divergent-universe-event-tourn-115-talk-403816583-line","entryId":"divergent-universe","chapterId":"event-tourn-115","missionId":"event-tourn-115","mission":"콜라보 제품","scene":"콜라보 제품","type":"dialogue","speaker":"시뮬레이션 우주","text":"좋다. 당신이 아는 학사를 합쳐도 두 손으로 셀 수 있을 정도니 굳이 이런 데 돈을 쓸 필요는 없다","talkId":403816583,"textHash":"13609746755263330171","source":"tournHandBookEvent:115/talk-403816583","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"809b691f9099c049","bwikiNextIds":[],"bwikiPage":"联名产品","bwikiRevision":95871,"bwikiMissionId":"bwiki-page-13814","bwikiMission":"콜라보 제품"},{"id":"divergent-universe-event-tourn-115-talk-403816584-line","entryId":"divergent-universe","chapterId":"event-tourn-115","missionId":"event-tourn-115","mission":"콜라보 제품","scene":"콜라보 제품","type":"dialogue","speaker":"시뮬레이션 우주","text":"가슴에 손을 얹고 물어보자. 이거 진짜로 가면의 우인이 파놓은 함정이 아닌 건가?","talkId":403816584,"textHash":"1651847722660978274","source":"tournHandBookEvent:115/talk-403816584","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"759bfab0351dc9a3","bwikiNextIds":[],"bwikiPage":"联名产品","bwikiRevision":95871,"bwikiMissionId":"bwiki-page-13814","bwikiMission":"콜라보 제품"},{"id":"divergent-universe-event-tourn-115-talk-403816585-line","entryId":"divergent-universe","chapterId":"event-tourn-115","missionId":"event-tourn-115","mission":"콜라보 제품","scene":"콜라보 제품","type":"dialogue","speaker":"시뮬레이션 우주","text":"매몰 비용을 포기하는 법을 배운 순간, 당신은 이미 학회의 절반보다 똑똑해진 것이다","talkId":403816585,"textHash":"8972386188316196433","source":"tournHandBookEvent:115/talk-403816585","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"ab8c3a3f26a79586","bwikiNextIds":[],"bwikiPage":"联名产品","bwikiRevision":95871,"bwikiMissionId":"bwiki-page-13814","bwikiMission":"콜라보 제품"}],"orderNote":"공식 사건 도감에 귀속된 한국어 원문입니다. BWIKI에서 확인한 모드별 구간만 연결하며 조건·확률·미확인 경계는 이어 붙이지 않습니다.","bwikiBaseOrder":["divergent-universe-event-tourn-115-talk-403816580-line","divergent-universe-event-tourn-115-talk-403816581-line","divergent-universe-event-tourn-115-talk-403816582-line","divergent-universe-event-tourn-115-text-16597175819054148068-choice","divergent-universe-event-tourn-115-text-16522073240195360112-choice","divergent-universe-event-tourn-115-text-347307584445858792-choice","divergent-universe-event-tourn-115-text-17278767016848671934-effect","divergent-universe-event-tourn-115-talk-403816583-line","divergent-universe-event-tourn-115-talk-403816584-line","divergent-universe-event-tourn-115-talk-403816585-line"],"bwiki":{"matchedRows":0,"cachedRows":10,"reviewRows":0,"segments":7,"reorderedRows":0},"retainedTextRowIds":[]}