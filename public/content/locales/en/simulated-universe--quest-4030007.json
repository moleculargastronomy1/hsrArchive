{"schema":"hsr-localizations.v1","language":"en","entryId":"simulated-universe","chapterId":"quest-4030007","referenceCommit":"312b4597691e0a29cf9828a15b592757dba86949","rows":[{"id":"simulated-universe-quest-4030007-quest-4030007-0","text":"Was World 2 difficult?","speaker":"Herta"},{"id":"simulated-universe-quest-4030007-quest-4030007-1","text":"It was way too hard.","speaker":""},{"id":"simulated-universe-quest-4030007-quest-4030007-2","text":"Piece of cake.","speaker":""},{"id":"simulated-universe-quest-4030007-quest-4030007-3","text":"What happened to the numbers!?","speaker":""},{"id":"simulated-universe-quest-4030007-quest-4030007-4","text":"Well, the Simulated Universe has an Ability Tree system. I'm debating whether to enable it... If I do, you'll gradually grow stronger in the simulation, but I can't say for sure whether that's a good thing. You try it out first.","speaker":"Herta"}]}
