{"schema":"hsr-localizations.v1","language":"en","entryId":"unknowable-domain","chapterId":"event-rogue-43","referenceCommit":"312b4597691e0a29cf9828a15b592757dba86949","rows":[{"id":"unknowable-domain-event-rogue-43-talk-403815112-line","text":"You meet a mechanical lifeform. It seems to be skilled in repairing Curios.","speaker":"Simulated Universe"},{"id":"unknowable-domain-event-rogue-43-talk-403815114-line","text":"It gestures for you to let it repair your treasures.","speaker":"Simulated Universe"},{"id":"unknowable-domain-event-rogue-43-text-6252097084963829918-choice","text":"Repair a damaged Curio.","speaker":""},{"id":"unknowable-domain-event-rogue-43-text-6738987606115192926-choice","text":"Repair all damaged Curios.","speaker":""},{"id":"unknowable-domain-event-rogue-43-text-673974022335536802-choice","text":"Express friendship to the inorganic life.","speaker":""},{"id":"unknowable-domain-event-rogue-43-text-8072431745826656662-choice","text":"Have a pleasant inorganic exchange!","speaker":""},{"id":"unknowable-domain-event-rogue-43-text-10260202661278391568-effect","text":"Replace all Curios with damageable Curios.","speaker":""},{"id":"unknowable-domain-event-rogue-43-text-13545507220346782516-choice","text":"Leave.","speaker":""},{"id":"unknowable-domain-event-rogue-43-text-12706601695007720461-effect","text":"You don't need this.","speaker":""}]}
