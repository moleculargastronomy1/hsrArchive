{"schema":"hsr-localizations.v1","language":"ja","entryId":"codex-relics","chapterId":"item-ItemConfigRelic-33085","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"codex-relics-item-ItemConfigRelic-33085-item-ItemConfigRelic-33085-0","text":"次元界の中に封装されているのは、ウェンワーク星で最も有名な島——ワーク島である。島は緑に覆われており、「サイスタン」という名の大きな木には、様々な動物の果実が生っている。","speaker":""}]}
