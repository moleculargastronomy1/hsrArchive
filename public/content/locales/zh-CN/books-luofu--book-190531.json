{"schema":"hsr-localizations.v1","language":"zh-CN","entryId":"books-luofu","chapterId":"book-190531","referenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","rows":[{"id":"books-luofu-book-190531","text":"且为郎君点红妆，朱唇如血肤如霜。\n且为郎君燃烛光，骨为灯芯肉做香。\n且为郎君解罗裳，芙蓉帐暖饱饥肠。\n此夜且与君成双，可怜我来日又守空房。","speaker":""}]}
