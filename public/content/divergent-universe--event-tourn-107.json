{"schema":"hsr-dialogue.v1","entryId":"divergent-universe","chapterId":"event-tourn-107","referenceCommit":"312b4597691e0a29cf9828a15b592757dba86949","textReferenceCommit":"74a7b96fba32f00cf495a5c00b0311bd02207aaf","sourceIds":["event-tourn-107"],"missing":0,"rows":[{"id":"divergent-universe-event-tourn-107-talk-403816080-line","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"dialogue","speaker":"시뮬레이션 우주","text":"당신은 쿠닌트의 금속 식품점에 있다. 가게 주인이 쉴 새 없이 상품을 추천한다. 그의 얼굴에는 검붉은 녹 얼룩이 가득했고, 지능 기계에 대한 자신의 숭배를 드러낸다","talkId":403816080,"textHash":"9570665288139116563","source":"tournHandBookEvent:107/talk-403816080","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"6c7da822acc3b3df","bwikiNextIds":["divergent-universe-event-tourn-107-talk-403816081-line"],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-talk-403816081-line","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"dialogue","speaker":"시뮬레이션 우주","text":"「아공정 캔디, 금속 순도 29%, 합금 맛 뿐만 아니라 씹을 때 나는 녹슨 향도 완벽하게 재현해냈습니다」","talkId":403816081,"textHash":"4315467077348129963","source":"tournHandBookEvent:107/talk-403816081","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"6c7da822acc3b3df","bwikiNextIds":["divergent-universe-event-tourn-107-talk-403816082-line"],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-talk-403816082-line","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"dialogue","speaker":"시뮬레이션 우주","text":"가게 주인은 깡통 속 캔디를 꺼내 당신의 손에 쥐여준다. 「드셔보세요. 진짜 합금 맛이에요」","talkId":403816082,"textHash":"10010947171604189309","source":"tournHandBookEvent:107/talk-403816082","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"6c7da822acc3b3df","bwikiNextIds":[],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-text-11527704075327650800-choice","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"choice","speaker":"","text":"그의 말을 계속 듣는다","talkId":null,"textHash":"11527704075327650800","source":"tournHandBookEvent:107/text-11527704075327650800","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"ce759d79383ae394","bwikiNextIds":["divergent-universe-event-tourn-107-text-15675770030076214610-effect"],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-text-15675770030076214610-effect","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"narration","speaker":"","text":"이렇게 열정적인데 어떻게 거절하겠는가","talkId":null,"textHash":"15675770030076214610","source":"tournHandBookEvent:107/text-15675770030076214610","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"ce759d79383ae394","bwikiNextIds":[],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활","bwikiReplyToIds":["divergent-universe-event-tourn-107-text-11527704075327650800-choice"]},{"id":"divergent-universe-event-tourn-107-talk-403816092-line","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"dialogue","speaker":"시뮬레이션 우주","text":"「그리고 이 자기 유체 아이스크림은 당신의 뱃속 엔진이 잘 돌게 해줄 겁니다」 가게 주인이 머리 아랫부분을 한 바퀴 돌리니, 등 뒤의 보철구가 아이스크림을 눈앞에 들이민다","talkId":403816092,"textHash":"13760157675198798867","source":"tournHandBookEvent:107/talk-403816092","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"0d8ddd1982e1e159","bwikiNextIds":[],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-text-12402995030936620589-choice","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"choice","speaker":"","text":"다른 것도 있나요?","talkId":null,"textHash":"12402995030936620589","source":"tournHandBookEvent:107/text-12402995030936620589","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"8cd7121ec3cd4dfa","bwikiNextIds":["divergent-universe-event-tourn-107-text-9630615966255331778-effect"],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-text-9630615966255331778-effect","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"narration","speaker":"","text":"조금 관심이 생겼다","talkId":null,"textHash":"9630615966255331778","source":"tournHandBookEvent:107/text-9630615966255331778","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"8cd7121ec3cd4dfa","bwikiNextIds":[],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활","bwikiReplyToIds":["divergent-universe-event-tourn-107-text-12402995030936620589-choice"]},{"id":"divergent-universe-event-tourn-107-talk-403816095-line","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"dialogue","speaker":"시뮬레이션 우주","text":"「물론이죠, 금속 순도 70% 이상의 굉장한 물건도 있답니다」 가게 주인은 비장의 컬렉션을 꺼냈다. 인위적으로 오래된 상자 위에는 루버트 제국의 엠블럼이 가득 새겨져 있다","talkId":403816095,"textHash":"4122976912442473800","source":"tournHandBookEvent:107/talk-403816095","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"b351e84720892078","bwikiNextIds":["divergent-universe-event-tourn-107-talk-403816096-line"],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-talk-403816096-line","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"dialogue","speaker":"시뮬레이션 우주","text":"「한 사람의 금속 순도가 100%를 초과하면 연약한 육체를 탈피하고 무기 생명체가 된다고 합니다」 가게 주인은 말을 할수록 신이 나는지 의안 4개가 눈구멍에서 미친 듯이 돌아간다","talkId":403816096,"textHash":"5617775547719040656","source":"tournHandBookEvent:107/talk-403816096","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"b351e84720892078","bwikiNextIds":["divergent-universe-event-tourn-107-talk-403816097-line"],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-talk-403816097-line","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"dialogue","speaker":"시뮬레이션 우주","text":"「생각해 보세요. 2세도 유기체였잖아요? 그가 지능 기계가 될 수 있다면 우리도 가능할 거예요」","talkId":403816097,"textHash":"14979578327228327205","source":"tournHandBookEvent:107/talk-403816097","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"b351e84720892078","bwikiNextIds":[],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-text-3256837634111136187-choice","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"choice","speaker":"","text":"전부 살게요!","talkId":null,"textHash":"3256837634111136187","source":"tournHandBookEvent:107/text-3256837634111136187","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"d8754501b33774d4","bwikiNextIds":[],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-talk-403816088-line","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"dialogue","speaker":"시뮬레이션 우주","text":"금속은 위대하고 금속은 신성하다. 유기를 초월했기에 더는 인간이 아니다","talkId":403816088,"textHash":"5181469473028536399","source":"tournHandBookEvent:107/talk-403816088","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"230629a655eb32a5","bwikiNextIds":[],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-text-3451679789519338288-choice","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"choice","speaker":"","text":"핑계를 대고 이곳을 떠난다","talkId":null,"textHash":"3451679789519338288","source":"tournHandBookEvent:107/text-3451679789519338288","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"5758fd6b1596d1a1","bwikiNextIds":[],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-talk-403816091-line","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"dialogue","speaker":"시뮬레이션 우주","text":"당신은 도망치지 않으면 머지않아 그에게 반유기 방정식을 영업 당할 것이라는 확신이 들었다","talkId":403816091,"textHash":"16393822553412656710","source":"tournHandBookEvent:107/talk-403816091","flowStatus":"review","bwikiStatus":"cached","bwikiScene":"099b33435acb5a18","bwikiNextIds":[],"bwikiPage":"金属生活","bwikiRevision":95831,"bwikiMissionId":"bwiki-page-13812","bwikiMission":"금속 생활"},{"id":"divergent-universe-event-tourn-107-text-5775588338049186161-choice","entryId":"divergent-universe","chapterId":"event-tourn-107","missionId":"event-tourn-107","mission":"금속 생활","scene":"금속 생활","type":"choice","speaker":"","text":"시식용 음식을 가지고 간다","talkId":null,"textHash":"5775588338049186161","source":"tournHandBookEvent:107/text-5775588338049186161","flowStatus":"review","bwikiStatus":"cached","bwikiScene":